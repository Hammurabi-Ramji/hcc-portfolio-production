#!/bin/bash
# ──────────────────────────────────────────────────────────────
# SUE - PRE-COMMIT HOOK
# Runs linting, formatting, and validation before commit
# ──────────────────────────────────────────────────────────────

set -e  # Exit on error

echo "╔═══════════════════════════════════════════════════════════╗"
echo "║     SUE - Pre-Commit Validation                          ║"
echo "╚═══════════════════════════════════════════════════════════╝"
echo ""

# Colors
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Track failures
FAILED=0

# Function to print status
print_status() {
  if [ $1 -eq 0 ]; then
    echo -e "${GREEN}✓${NC} $2"
  else
    echo -e "${RED}✗${NC} $2"
    FAILED=1
  fi
}

# 1. Check if files are staged
echo "📋 Checking staged files..."
if git diff --cached --name-only | grep -qE '\.(js|ts|tsx|json|md)$'; then
  print_status 0 "Files to check found"
else
  print_status 0 "No relevant files staged, skipping"
  exit 0
fi

echo ""

# 2. ESLint check
echo "🔍 Running ESLint..."
if command -v npx &> /dev/null; then
  npx eslint --max-warnings=0 $(git diff --cached --name-only | grep -E '\.(js|ts|tsx)$' | tr '\n' ' ')
  print_status $? "ESLint"
else
  echo -e "${YELLOW}⚠${NC} npx not found, skipping ESLint"
fi

echo ""

# 3. Prettier check
echo "✍️ Checking code formatting..."
if command -v npx &> /dev/null; then
  STAGED_FILES=$(git diff --cached --name-only | grep -E '\.(js|ts|tsx|json|css)$' | tr '\n' ' ')
  if [ -n "$STAGED_FILES" ]; then
    if ! npx prettier --check $STAGED_FILES > /dev/null 2>&1; then
      echo -e "${YELLOW}⚠${NC} Formatting issues found. Run 'npm run format' to fix."
    else
      print_status 0 "Prettier"
    fi
  else
    print_status 0 "No files to format"
  fi
else
  echo -e "${YELLOW}⚠${NC} npx not found, skipping Prettier"
fi

echo ""

# 4. TypeScript check
echo "🔷 Checking TypeScript..."
if [ -f "tsconfig.json" ]; then
  if command -v npx &> /dev/null; then
    npx tsc --noEmit
    print_status $? "TypeScript"
  else
    echo -e "${YELLOW}⚠${NC} npx not found, skipping TypeScript"
  fi
else
  echo -e "${YELLOW}⚠${NC} No tsconfig.json found, skipping TypeScript"
fi

echo ""

# 5. Spell check
echo "📖 Running spell check..."
if command -v npx &> /dev/null; then
  STAGED_TEXT_FILES=$(git diff --cached --name-only | grep -E '\.(md|json|js|ts)$' | tr '\n' ' ')
  if [ -n "$STAGED_TEXT_FILES" ]; then
    npx cspell $STAGED_TEXT_FILES 2>/dev/null || true
    print_status $? "cSpell"
  else
    print_status 0 "No text files to spell check"
  fi
else
  echo -e "${YELLOW}⚠${NC} npx not found, skipping cSpell"
fi

echo ""

# 6. WASM build check (if Rust files changed)
echo "🦀 Checking WASM build..."
if git diff --cached --name-only | grep -qE '\.rs$|Cargo\.(toml|lock)$'; then
  if [ -f "sue-view/Cargo.toml" ]; then
    echo -e "${YELLOW}⚠${NC} Rust files changed. Ensure WASM builds successfully:"
    echo "   cd sue-view && wasm-pack build --release"
  fi
else
  print_status 0 "No Rust changes"
fi

echo ""

# Final result
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
if [ $FAILED -eq 0 ]; then
  echo -e "${GREEN}✓ All checks passed! Ready to commit.${NC}"
  exit 0
else
  echo -e "${RED}✗ Some checks failed. Please fix the issues above.${NC}"
  echo ""
  echo "💡 Quick fixes:"
  echo "   npm run format     # Fix formatting"
  echo "   npm run lint       # Fix linting errors"
  echo "   npm run typecheck  # Fix TypeScript errors"
  echo "   npm run spellcheck # Fix spelling errors"
  exit 1
fi
