# Ramblox - Environment Variables
# Using SQLite instead of Supabase

# ============ DATABASE ============
# SQLite database path (default: data/ramblox.db)
SQLITE_PATH=

# ============ SECURITY ============
# Session secret for signing tokens
SESSION_SECRET=your-secret-key-here-change-in-production
SESSION_EXPIRY=604800000  # 7 days in milliseconds

# ============ API ============
# AI Asset Generation (optional - placeholder for now)
# AI_API_KEY=your_ai_api_key
# AI_API_URL=https://api.example.com/generate

# ============ SERVER ============
# Server port
PORT=3000

# ============ DEVELOPMENT ============
# Enable debug logging
DEBUG=true

# ============ PRODUCTION ============
# Set to 'production' for production builds
NODE_ENV=development
