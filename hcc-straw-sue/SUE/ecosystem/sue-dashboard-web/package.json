{
  "name": "sue-dashboard-web",
  "version": "5.0.0",
  "description": "SUE Web Dashboard - Notes, Projects, Collaboration",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "cypress open",
    "validate": "pnpm run lint && pnpm run format && pnpm run type-check"
  },
  "dependencies": {
    "next": "^14.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@tanstack/react-query": "^5.28.0",
    "@tanstack/react-router": "^1.29.0",
    "zustand": "^4.4.1",
    "axios": "^1.6.2",
    "socket.io-client": "^4.7.2",
    "lucide-react": "^0.375.0",
    "date-fns": "^3.0.0",
    "markdown-it": "^13.0.2",
    "@monaco-editor/react": "^4.6.0",
    "recharts": "^2.10.3",
    "framer-motion": "^10.16.16"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/react": "^18.2.37",
    "@types/node": "^20.10.6",
    "tailwindcss": "^3.4.1",
    "postcss": "^8.4.32",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.55.0",
    "eslint-config-next": "^14.1.0",
    "prettier": "^3.1.1",
    "@testing-library/react": "^14.1.2",
    "jest": "^29.7.0",
    "cypress": "^13.6.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
