{
  "name": "sue-sidebar-extension",
  "version": "5.0.0",
  "description": "SUE Sovereign Sidebar Extension",
  "private": true,
  "scripts": {
    "api": "node local-api-server.js",
    "build:api-exe": "pkg local-api-server.js --target node18-win-x64 --output installer/assets/sue-api.exe",
    "build:host-exe": "pkg native-host/host.js --target node18-win-x64 --output installer/assets/sue-host.exe && copy installer\\assets\\sue-host.exe native-host\\sue-host.exe",
    "build:installer": "cd installer && pkg . && cd ..",
    "build:release": "pnpm build:api-exe && pnpm build:host-exe && pnpm build:installer",
    "release:zip": "powershell -ExecutionPolicy Bypass -File build-release.ps1",
    "build:wasm": "cd sue-view && wasm-pack build --release --target web --no-opt",
    "build:wasm-dev": "cd sue-view && wasm-pack build --dev --target web",
    "build": "pnpm run build:wasm",
    "bundle": "node node_modules/webpack-cli/bin/cli.js --config webpack.config.js",
    "package": "pnpm run build && pnpm run bundle",
    "build:browsers": "pnpm run package && node build-browser-packages.js",
    "check": "pnpm run validate",
    "verify:local": "pnpm run package && pnpm run validate && pnpm test && node check.js",
    "dev": "pnpm run build:wasm-dev && pnpm run bundle -- --watch",
    "dev:ext": "web-ext run --source-dir=dist --target=chromium --browser-console",
    "rebuild": "pnpm run clean && pnpm run package",
    "clean": "rimraf sue-view/pkg dist/ dist-browsers/",
    "lint": "eslint *.js --ignore-pattern dist/",
    "lint:fix": "eslint *.js --ignore-pattern dist/ --fix",
    "format": "prettier --write \"*.{js,ts,json,css}\" \"src/**/*.{js,ts,json,css}\" \"types/**/*.{ts,json}\"",
    "format:check": "prettier --check \"*.{js,ts,json,css}\" \"src/**/*.{js,ts,json,css}\" \"types/**/*.{ts,json}\"",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "node --test tests/unit/local-api-server.test.js",
    "test:e2e": "pnpm run package && playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "validate": "pnpm run lint && pnpm run format:check && pnpm run typecheck",
    "ci": "pnpm run package && pnpm run validate && pnpm run test",
    "size": "twiggy top sue-view/pkg/sue_view_bg.wasm --number 20",
    "size:dist": "twiggy top dist/sue-view.wasm --number 20",
    "audit": "cargo audit",
    "check:wasm": "cargo clippy --manifest-path sue-view/Cargo.toml --target wasm32-unknown-unknown -- -D warnings"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "concurrently": "^9.2.1",
    "copy-webpack-plugin": "^11.0.0",
    "cross-env": "^10.1.0",
    "cspell": "^8.19.4",
    "eslint": "^8.57.1",
    "json-schema-traverse": "^1.0.0",
    "prettier": "^3.8.3",
    "rimraf": "^5.0.10",
    "typescript": "^5.9.3",
    "web-ext": "^10.1.0",
    "webpack": "^5.106.2",
    "webpack-cli": "^5.1.4",
    "ws": "^8.20.1"
  },
  "keywords": [
    "webextension",
    "browser-extension",
    "leptos",
    "rust",
    "wasm",
    "sue",
    "sovereign"
  ],
  "license": "MIT",
  "pkg": {
    "assets": [
      "installer/assets/sue-host.exe",
      "installer/assets/sue-api.exe"
    ]
  }
}
