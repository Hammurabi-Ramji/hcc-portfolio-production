@echo off
setlocal enabledelayedexpansion

set SCRIPT_DIR=%~dp0

echo ??????????????????????????????????????????????????????????????
echo ?  RADIX APP - Enterprise ERP System                         ?
echo ?  Production Build - Windows 11                             ?
echo ??????????????????????????????????????????????????????????????
echo.

cd /d "%SCRIPT_DIR%"

REM Check Node.js installation
where node >nul 2>nul
if %ERRORLEVEL% NEQ 0 (
    echo ERROR: Node.js is not installed or not in PATH
    echo Please install Node.js 18+ from https://nodejs.org/
    pause
    exit /b 1
)

REM Start backend
echo Starting backend server on port 3001...
start "Radix App Backend" cmd /k "cd backend && npm start"

REM Wait for backend to start
timeout /t 3 /nobreak

REM Start frontend
echo Starting frontend application on port 5173...
start "Radix App Frontend" cmd /k "cd frontend && npm start"

echo.
echo ? Radix App has been launched!
echo   Backend:  http://localhost:3001
echo   Frontend: http://localhost:5173
echo.
pause
