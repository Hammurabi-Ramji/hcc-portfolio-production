# Copy to .env.local in this folder. These defaults match the local Rust API.
# Do not put passwords, session secrets, or database files in this template.

# Next public site URL. Used by apps/web/utils/config.ts.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only proxy settings. The browser does not call this port directly.
# STRAW_API_PORT and STRAW_WEB_ORIGIN must match the apps/api process.
STRAW_API_PORT=3001
STRAW_WEB_ORIGIN=http://localhost:3000

NODE_ENV=development
