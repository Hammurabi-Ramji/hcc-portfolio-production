{
  "name": "sue-cli",
  "version": "5.0.0",
  "description": "SUE Command Line Interface - Batch operations, automation, local management",
  "main": "dist/index.js",
  "bin": {
    "sue": "dist/cli.js"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc",
    "prepublishOnly": "pnpm run build",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "validate": "pnpm run lint && pnpm run type-check"
  },
  "dependencies": {
    "commander": "^11.1.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.1",
    "inquirer": "^8.2.5",
    "axios": "^1.6.2",
    "sqlite3": "^5.1.6",
    "better-sqlite3": "^9.2.2",
    "csv-parser": "^3.0.0",
    "papaparse": "^5.4.1",
    "dotenv": "^16.3.1",
    "table": "^6.8.1",
    "globby": "^14.0.1",
    "fs-extra": "^11.2.0",
    "uuid": "^9.0.1",
    "date-fns": "^3.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/node": "^20.10.6",
    "@types/inquirer": "^8.2.10",
    "@types/jest": "^29.5.11",
    "tsx": "^4.7.0",
    "eslint": "^8.55.0",
    "prettier": "^3.1.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
