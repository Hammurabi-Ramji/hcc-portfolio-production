{
  "manifest_version": 3,
  "name": "SUE — Sovereign Sidebar",
  "version": "4.0.0",
  "description": "Your sovereign AI and cloud workspace — always accessible",
  "author": "R.K. Girdhari <rk@hammurabicoding.com>",
  "homepage_url": "https://hammurabicoding.com",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open SUE",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sue.html"
  },
  "permissions": ["storage", "activeTab", "scripting", "tabs", "sidePanel", "notifications", "offscreen", "alarms", "cookies", "contextMenus", "nativeMessaging", "permissions"],
  "optional_permissions": ["downloads", "bookmarks", "history"],
  "commands": {
    "toggle-ai-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+A"
      },
      "description": "Toggle SUE side panel"
    },
    "quick-command": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space"
      },
      "description": "Run a quick in-page SUE command"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "sue-view.wasm",
        "sue-view.js",
        "sue-runtime.wasm",
        "sue-runtime.js",
        "sidebar-init.js",
        "sidebar-init-debug.js",
        "sue-debug.html",
        "styles.css",
        "popover.css",
        "offline.html",
        "offline-handler.js",
        "speculation-rules.html",
        "offscreen.html",
        "offscreen-worker.js",
        "offscreen-manager.js",
        "keepalive-manager.js",
        "storage-manager.js",
        "intent-router.js",
        "tool-registry.js",
        "suewarm-tool-registry.js",
        "vector-store.js",
        "memory-manager.js",
        "security-manager.js",
        "ai-agent.js",
        "suewarm-agent-core.js",
        "native-bridge.js",
        "view-transitions-manager.js",
        "view-transitions-enhanced.js",
        "popover-manager.js",
        "opfs-manager.js",
        "webgpu-manager.js",
        "web-locks-manager.js",
        "compression-manager.js",
        "background-fetch-manager.js",
        "eyedropper-manager.js",
        "icons/*",
        "icons/*.png",
        "icons/*.svg",
        "icons/*.ico"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "host_permissions": [
    "http://localhost:11434/*",
    "http://localhost:8080/*",
    "https://app.koofr.net/*",
    "https://*.koofr.net/*",
    "https://icedrive.net/*",
    "https://app.icedrive.net/*",
    "https://degoo.com/*",
    "https://app.degoo.com/*"
  ]
}
