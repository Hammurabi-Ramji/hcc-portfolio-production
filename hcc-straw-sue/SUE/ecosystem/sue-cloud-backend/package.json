{
  "name": "sue-cloud-backend",
  "version": "5.0.0",
  "description": "SUE Cloud Backend - API Server, Sync, Authentication",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx src/db/seed.ts",
    "validate": "pnpm run lint && pnpm run type-check"
  },
  "dependencies": {
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "dotenv": "^16.3.1",
    "prisma": "^5.7.1",
    "@prisma/client": "^5.7.1",
    "jsonwebtoken": "^9.1.2",
    "bcryptjs": "^2.4.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-google-oauth20": "^2.0.0",
    "passport-github2": "^0.1.12",
    "redis": "^4.6.12",
    "bull": "^4.11.5",
    "socket.io": "^4.7.2",
    "axios": "^1.6.2",
    "zod": "^3.22.4",
    "pino": "^8.17.2",
    "pino-http": "^8.6.1",
    "uuid": "^9.0.1",
    "date-fns": "^3.0.0",
    "node-cron": "^3.0.2"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/cors": "^2.8.17",
    "@types/bcryptjs": "^2.4.2",
    "@types/jest": "^29.5.11",
    "tsx": "^4.7.0",
    "eslint": "^8.55.0",
    "prettier": "^3.1.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "@testing-library/jest-dom": "^6.1.5",
    "supertest": "^6.3.3",
    "@types/supertest": "^6.0.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
