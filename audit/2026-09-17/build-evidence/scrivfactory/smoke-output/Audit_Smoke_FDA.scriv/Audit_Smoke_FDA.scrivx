  <Collections>
    <Collection Name="Action Items" Type="search">
      <Criteria>text contains 'Action Item' OR 'TODO'</Criteria>
    </Collection>
    <Collection Name="Due This Week" Type="search">
      <Criteria>Review_Date within 7 days</Criteria>
    </Collection>
    <Collection Name="FDA Critical Docs" Type="manual">
      <Description>Key documents that inspectors request most often.</Description>
    </Collection>
    <Collection Name="Pending Approval" Type="search">
      <Criteria>Approval_Status equals 'Under Review'</Criteria>
    </Collection>
  </Collections>
  <CustomMetaDataSettings>
    <MetaDataField Name="Document_Type" Type="text" Default="" />
    <MetaDataField Name="Effective_Date" Type="date" Default="" />
    <MetaDataField Name="Review_Date" Type="date" Default="" />
    <MetaDataField Name="Document_Number" Type="text" Default="" />
    <MetaDataField Name="Approval_Status" Type="list" Default="Draft">
      <Options>
        <Option>Draft</Option>
        <Option>Under Review</Option>
        <Option>Approved</Option>
      </Options>
    </MetaDataField>
    <MetaDataField Name="Owner" Type="text" Default="" />
  </CustomMetaDataSettings>
  <DocumentTemplates>
    <Template Name="SOP Template" UUID="48624440-E3AC-413A-8626-911191E3A815">
      <Description>Standard Operating Procedure template</Description>
    </Template>
    <Template Name="CAPA Form Template" UUID="4F53E865-B565-4C4A-BB52-FEECECA1529D">
      <Description>Corrective and Preventive Action form</Description>
    </Template>
    <Template Name="Checklist Template" UUID="E3C27437-B7AF-4B98-9722-9EDCF1769903">
      <Description>Inspection readiness checklist</Description>
    </Template>
  </DocumentTemplates>
</ScrivenerProject>