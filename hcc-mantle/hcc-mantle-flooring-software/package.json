{
  "name": "northstar-installations",
  "version": "1.0.0",
  "description": "Professional flooring & installation management platform (SQLite3 Edition)",
  "private": true,
  "workspaces": [
    "backend/*",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspaces\"",
    "start": "npm run start --workspaces",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "test:ci": "npm run test:ci --workspaces",
    "lint": "npm run lint --workspaces",
    "init:databases": "node scripts/init-databases.js",
    "seed:data": "node scripts/seed-data.js",
    "setup": "npm install && npm run init:databases && npm run seed:data",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:restart": "docker-compose restart",
    "docker:clean": "docker-compose down -v && rm -rf ./data/*.db",
    "verify": "npm run test:ci && npm run lint"
  },
  "type": "module",
  "devDependencies": {
    "concurrently": "^8.2.0",
    "eslint": "^8.56.0",
    "@eslint/js": "^8.56.0",
    "globals": "^13.24.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
